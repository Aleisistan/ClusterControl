# Variables de la API NestJS.
# Copia este archivo como backend/.env:
#   cp backend/.env.example backend/.env

# API
PORT=3000

# Autenticacion. Usa una cadena larga, aleatoria y distinta por entorno.
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES=1d

# MQTT. En Docker, usa el nombre del servicio, no localhost.
MQTT_SERVER=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# PostgreSQL. DB_PASSWORD debe coincidir con POSTGRES_PASSWORD de ../.env.
DB_HOST=postgres
DB_PORT=5432
DB_USER=dcuser
DB_PASSWORD=cambiar_por_una_clave_local
DB_NAME=datacenter

# Camara IP opcional. Dejalo vacio si no hay una camara configurada.
CAMERA_URL=

# Clima opcional. Solicita una clave en https://openweathermap.org/api.
OPENWEATHER_API_KEY=

# SMTP opcional para alertas por correo.
# Gmail requiere una contrasena de aplicacion, no la contrasena normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=