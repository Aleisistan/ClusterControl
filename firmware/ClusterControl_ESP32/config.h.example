#pragma once

// Copia este archivo como config.h y completa los valores del sitio.
#define WIFI_SSID "cambiar-ssid"
#define WIFI_PASSWORD "cambiar-password"
#define WIFI_USE_BSSID 0
#define WIFI_CHANNEL 1
#define WIFI_BSSID {0x00, 0x00, 0x00, 0x00, 0x00, 0x00}

#define MQTT_HOST "192.168.1.50"
#define MQTT_PORT 1883
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""

// Lo asigna ClusterControl al crear el cluster. Debe ser numerico.
#define DEVICE_ID "4"

// Opcional. Deja vacio si no hay camara IP asociada.
#define CAMERA_IP ""

// Intervalo entre publicaciones de telemetria.
#define TELEMETRY_INTERVAL_MS 15000UL

// Tiempo maximo de espera por conexion Wi-Fi/MQTT.
#define CONNECTION_RETRY_MS 5000UL

// Histeresis para extractor y aire acondicionado.
#define TEMP_ON 28.0f
#define TEMP_OFF 25.0f
#define HUM_ON 65.0f
#define HUM_OFF 60.0f

// Codigos COOLIX: encendido por defecto (25 C, automatico) y apagado.
// Verifica o reemplaza estos codigos para el modelo de aire acondicionado.
#define IR_POWER_ON 0xB21FC8UL
#define IR_POWER_OFF 0xB27BE0UL
