# Referencia de credenciales para produccion; no es un password_file operativo.
#
# Backend: configura estos valores en .env.
# MQTT_USER=clustercontrol-backend
# MQTT_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_MQTT_ALEATORIA

# Dispositivos: configura estos valores en firmware/esp32-mqtt-base/config.h.
# MQTT_USERNAME="clustercontrol-device"

# Genera el password_file real con mosquitto_passwd usando esos usuarios y
# contrasenas. Mosquitto requiere hashes; no pegues contrasenas en este archivo.
# Los usuarios deben coincidir con mosquitto/config/aclfile.
