# URL de API que usa Angular. En desarrollo, usa una URL accesible desde el navegador.
# En produccion, normalmente /api para pasar por el proxy interno de Nginx.
API_URL=/api
# URL publica de Socket.IO; vacia usa el mismo host del frontend.
SOCKET_URL=
# Destino interno del proxy Nginx en produccion; no es accesible desde el navegador.
BACKEND_URL=http://backend:3000
FRONTEND_HOST_PORT=80
MQTT_HOST_PORT=1883

# PostgreSQL. DB_* debe coincidir con POSTGRES_*.
POSTGRES_DB=clustercontrol
POSTGRES_USER=clustercontrol
POSTGRES_PASSWORD=REEMPLAZAR_CON_LA_MISMA_CLAVE
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clustercontrol
DB_USER=clustercontrol
DB_PASSWORD=REEMPLAZAR_CON_LA_MISMA_CLAVE

# Autenticacion: generar un secreto largo y aleatorio.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES=1d
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA

# Mosquitto del Compose permite conexiones anonimas por defecto.
MQTT_SERVER=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# Servicios opcionales.
OPENWEATHER_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
