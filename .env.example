# Variables usadas por docker-compose.dev.yml para PostgreSQL y pgAdmin.
# Copia este archivo como .env en la raiz del proyecto:
#   cp .env.example .env

# PostgreSQL
# Estos valores deben coincidir con DB_USER, DB_PASSWORD y DB_NAME de backend/.env.
POSTGRES_DB=datacenter
POSTGRES_USER=dcuser
POSTGRES_PASSWORD=cambiar_por_una_clave_local

# pgAdmin
# Usa una direccion de correo valida si quieres recibir avisos de pgAdmin.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambiar_por_otra_clave_local